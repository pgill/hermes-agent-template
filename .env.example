# ── Required: at least one LLM provider key ─────────────────────────────────

# Recommended: OpenRouter (access to all models via one key)
OPENROUTER_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4o-mini

# Or: direct OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Or: direct Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5

# ── Optional: Tool APIs ──────────────────────────────────────────────────────

# Web search (pick one or more)
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=

# Image generation
FAL_KEY=

# Cross-session user modeling
HONCHO_API_KEY=

# GitHub (higher rate limits for code tools / private repo access)
GITHUB_TOKEN=

# ── Workspace backup (required) ───────────────────────────────────────────────
# Hourly git backups of your Hermes workspace (skills, memories, config, hooks)
# to a private GitHub repo. The repo is created automatically on first boot.
# Secrets (.env, auth.json) are excluded via .gitignore and never committed.
BACKUP_GITHUB_TOKEN=
# Optional — defaults to <github_username>/hermes-backup:
# BACKUP_REPO=your-username/hermes-backup
#
# Optional — Telegram chat ID to receive an alert if backup goes stale (>25h):
# BACKUP_TELEGRAM_CHAT_ID=123456789

# ── Hermes auto-update (optional) ─────────────────────────────────────────────
# The weekly auto-update cron (scripts/hermes-auto-update.sh) rebuilds this
# service whenever the deploy repo bumps its pinned Hermes version. It needs a
# workspace-scoped token from railway.com/account/tokens:
# RAILWAY_TOKEN=
#
# Deploy-repo OWNER only (leave unset otherwise): a GitHub token with write
# access to the deploy repo lets the cron also push the HERMES_REF bump when
# upstream hermes-agent publishes a new release:
# HERMES_UPDATE_GITHUB_TOKEN=

# Shared GBrain backed by Supabase/Postgres. Use the Supabase Transaction
# Pooler URL for GBRAIN_SUPABASE_URL / GBRAIN_DATABASE_URL. If your runtime
# cannot reach Supabase's IPv6-only direct DB host, set the Session Pooler URL
# as GBRAIN_DIRECT_DATABASE_URL for migrations/DDL/worker locks.
GBRAIN_SUPABASE_URL=
GBRAIN_DIRECT_DATABASE_URL=
ZEROENTROPY_API_KEY=

# ── Auto-updates (Chapter 6) ─────────────────────────────────────────────────
# Enables weekly self-updates: your agent checks for a new Hermes version and
# redeploys automatically. Add RAILWAY_TOKEN here — service and environment
# IDs are already injected by Railway (no manual setup needed).
#
# Get your token at: railway.com/account/tokens (workspace scope)
# Then ask your agent: "turn on auto-updates" to register the weekly cron.
RAILWAY_TOKEN=

# ── Optional: Browser automation ─────────────────────────────────────────────
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ── Gateway security ──────────────────────────────────────────────────────────
# Set to false and configure allowlists if you want to restrict access
GATEWAY_ALLOW_ALL_USERS=true

# ── Terminal backend ──────────────────────────────────────────────────────────
# Options: local, docker, modal, ssh
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60

# ── Optional: additional Hermes profile gateways ──────────────────────────────
# The template always manages the default gateway configured above. To keep
# extra profile gateways alive after Railway restarts, configure them without
# editing this repo:
#
# 1. Create/configure profile(s) on the persistent volume, e.g.
#    hermes profile create documenter --clone
#    hermes -p documenter gateway setup
#
# 2. Add profile names here as a comma-separated list:
# HERMES_MANAGED_PROFILES=documenter,finance
#
# Or auto-discover every profile that has a messaging channel configured:
# HERMES_MANAGED_PROFILES=all
# # same as:
# HERMES_AUTO_START_PROFILES=true
#
# Or put JSON on the volume at /data/.hermes/managed-profiles.json:
# {"profiles":["documenter",{"name":"finance","enabled":true}]}
#
# Each profile needs its own bot token/account. The supervisor refuses to start
# a profile that reuses the default profile's Telegram/Discord/Slack/etc. token.
HERMES_MANAGED_PROFILES=
HERMES_AUTO_START_PROFILES=false
HERMES_MANAGED_PROFILES_FILE=/data/.hermes/managed-profiles.json
